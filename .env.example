NODE_ENV=development
PORT=3000

# PostgreSQL (Neon) — URL de connexion fournie par le dashboard Neon
DATABASE_URL=postgresql://user:password@ep-cool-service-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Stripe — Clés du mode SANDBOX/TEST (format générique pour éviter le blocage Git)
STRIPE_SECRET_KEY=sk_test_51YOUR_TEST_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET_HERE

# Eureka / Service Discovery
EUREKA_HOST=discovery-service
EUREKA_PORT=8761
SERVICE_NAME=payment-service
SERVICE_HOST=payment-service
SERVICE_PORT=3000

# Délai avant la première tentative d'enregistrement Eureka (en ms)
EUREKA_START_DELAY_MS=5000
